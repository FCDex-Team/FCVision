{
	"name": "fcvision",
	"description": "FCVision is an exclusive football penalty-shootout minigame bot built with Seyfert.",
	"module": "src/index.ts",
	"private": true,
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun --watch run src/index.ts",
		"check": "bunx biome check",
		"check:fix": "bunx biome check --write",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/bun": "1.3.14",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"seyfert": "^4.5.0"
	}
}
